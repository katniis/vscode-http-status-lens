{
  "name": "http-status-lens",
  "displayName": "HTTP Status Lens",
  "description": "See possible Express response statuses in your code.",
  "version": "0.1.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/katniis/vscode-http-status-lens.git"
  },
  "engines": {
    "vscode": "^1.142.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "title": "HTTP Status Lens",
      "properties": {
        "httpStatusLens.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show possible response statuses above Express routes."
        }
      }
    }
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src test esbuild.mjs .vscode-test.mjs",
    "build": "node esbuild.mjs",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && mocha \"out/test/unit/**/*.test.js\"",
    "test:smoke": "vscode-test --label smoke",
    "test": "npm run test:unit && npm run test:smoke",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.8.1",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.25.11",
    "eslint": "^9.38.0",
    "mocha": "^12.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "overrides": {
    "@vscode/test-cli": {
      "mocha": "$mocha"
    }
  }
}
